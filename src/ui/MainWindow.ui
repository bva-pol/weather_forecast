<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>756</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Метеостанция</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
      QMainWindow {
          background-color: #f0f4f8;
      }

      /* Стили для выпадающего списка */
      QComboBox {
          font-size: 14px;
          padding: 8px 12px;
          border: 2px solid #bdc3c7;
          border-radius: 5px;
          background-color: white;
          min-width: 200px;
          color: #2c3e50;
      }

      QComboBox:hover {
          border: 2px solid #3498db;
          background-color: #f8f9fa;
      }

      QComboBox:focus {
          border: 2px solid #3498db;
      }

      /* Стиль для выпадающей стрелки */
      QComboBox::drop-down {
          subcontrol-origin: padding;
          subcontrol-position: top right;
          width: 30px;
          border-left: 1px solid #d5dbdb;
          border-top-right-radius: 5px;
          border-bottom-right-radius: 5px;
          background-color: #f8f9fa;
      }

      QComboBox::drop-down:hover {
          background-color: #e8f0fe;
      }

      /* Стрелка */
      QComboBox::down-arrow {
          image: none;
          border-left: 5px solid transparent;
          border-right: 5px solid transparent;
          border-top: 6px solid #7f8c8d;
          margin-top: 2px;
      }

      QComboBox::down-arrow:hover {
          border-top: 6px solid #3498db;
      }

      /* ГЛАВНОЕ ИСПРАВЛЕНИЕ: стиль для выбранного элемента в выпадающем списке */
      QComboBox QAbstractItemView {
          background-color: white;
          border: 1px solid #bdc3c7;
          border-radius: 4px;
          padding: 4px;
          selection-background-color: #3498db;
          selection-color: white;
          color: #2c3e50;
          outline: none;
      }

      QComboBox QAbstractItemView::item {
          min-height: 30px;
          padding: 8px 12px;
          color: #2c3e50;
          border-radius: 3px;
      }

      QComboBox QAbstractItemView::item:hover {
          background-color: #e8f0fe;
          color: #2c3e50;
      }

      QComboBox QAbstractItemView::item:selected {
          background-color: #3498db;
          color: white;
      }

      /* Исправление для текста в самом комбобоксе */
      QComboBox QAbstractItemView::item:selected:!active {
          background-color: #3498db;
          color: white;
      }

      QComboBox QAbstractItemView::item:selected:active {
          background-color: #2980b9;
          color: white;
      }

      /* Стиль для текста при наведении на выбранный элемент */
      QComboBox QAbstractItemView::item:selected:hover {
          background-color: #2980b9;
          color: white;
      }

      /* Убираем фокусную рамку */
      QComboBox QAbstractItemView::item:focus {
          outline: none;
          border: none;
      }

      QLabel#labelCityName {
          font-size: 24px;
          font-weight: bold;
          color: #2c3e50;
          padding: 10px;
      }

      QLabel#labelTemperature {
          font-size: 64px;
          font-weight: bold;
          color: #2980b9;
          padding: 5px;
      }

      QLabel.infoLabel {
          font-size: 14px;
          color: #34495e;
          padding: 3px;
      }

      QPushButton {
          background-color: #3498db;
          color: white;
          border: none;
          padding: 10px 20px;
          font-size: 14px;
          font-weight: bold;
          border-radius: 5px;
          min-width: 120px;
      }

      QPushButton:hover {
          background-color: #2980b9;
      }

      QPushButton:pressed {
          background-color: #1f618d;
      }

      QGroupBox {
          font-size: 16px;
          font-weight: bold;
          border: 2px solid #d5dbdb;
          border-radius: 8px;
          margin-top: 10px;
          padding-top: 10px;
          background-color: white;
      }

      QGroupBox::title {
          subcontrol-origin: margin;
          left: 10px;
          padding: 0 5px 0 5px;
          color: #2c3e50;
      }
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayoutMain" stretch="0,0,1">
    <property name="spacing">
